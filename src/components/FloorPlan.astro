---
import type { Library, RoomDesign, RoomState, Wall } from "../lib/layout";

interface Props {
  library: Library;
  rooms: { id: number; design: RoomDesign; state: RoomState; href: string; name: string }[];
}

const { library, rooms } = Astro.props;
const W = library.viewBox.w;
const H = library.viewBox.h;
const hatchId = `hatch-${library.id}`;

const stateWords: Record<RoomState, string> = { now: "in use now", booked: "booked later", free: "free" };


// Decorative plan features, pre-expanded into primitive shapes.
const features = library.features.map((f) => {
  const lines: { x1: number; y1: number; x2: number; y2: number }[] = [];
  const blocks: { x: number; y: number; w: number; h: number }[] = [];
  if (f.kind === "stairs") {
    for (let y = f.y + 8; y < f.y + f.h; y += 8) lines.push({ x1: f.x, y1: y, x2: f.x + f.w, y2: y });
  } else if (f.kind === "lift") {
    lines.push({ x1: f.x, y1: f.y, x2: f.x + f.w, y2: f.y + f.h }, { x1: f.x + f.w, y1: f.y, x2: f.x, y2: f.y + f.h });
  } else if (f.kind === "stacks") {
    for (let y = f.y + 14; y + 8 <= f.y + f.h; y += 18) blocks.push({ x: f.x, y, w: f.w, h: 8 });
  } else if (f.kind === "tables") {
    const cols = Math.max(1, Math.floor(f.w / 42));
    const rows = Math.max(1, Math.floor((f.h - 14) / 22));
    for (let r = 0; r < rows; r++)
      for (let c = 0; c < cols; c++) blocks.push({ x: f.x + c * 42 + 6, y: f.y + 16 + r * 22, w: 28, h: 12 });
  }
  const outlined = f.kind === "stairs" || f.kind === "lift" || f.kind === "room" || f.kind === "void";
  // Labels sit inside rooms, below stairs and lifts, and above everything else.
  const labelPos =
    f.kind === "room"
      ? { x: f.x + f.w / 2, y: f.y + f.h / 2 + 4, anchor: "middle" }
      : f.kind === "stairs" || f.kind === "lift"
        ? { x: f.x, y: f.y + f.h + 13, anchor: "start" }
        : { x: f.x, y: f.y + 10, anchor: "start" };
  return { ...f, lines, blocks, outlined, labelPos };
});

// Where a wall segment sits for a room, as a line — used for the door gap,
// the screen and the whiteboard.
function wallSegment(d: RoomDesign, wall: Wall, from: number, to: number) {
  if (wall === "west") return { x1: d.x, y1: d.y + d.h * from, x2: d.x, y2: d.y + d.h * to };
  if (wall === "east") return { x1: d.x + d.w, y1: d.y + d.h * from, x2: d.x + d.w, y2: d.y + d.h * to };
  if (wall === "north") return { x1: d.x + d.w * from, y1: d.y, x2: d.x + d.w * to, y2: d.y };
  return { x1: d.x + d.w * from, y1: d.y + d.h, x2: d.x + d.w * to, y2: d.y + d.h };
}

const opposite: Record<Wall, Wall> = { west: "east", east: "west", north: "south", south: "north" };
const side: Record<Wall, Wall> = { west: "north", east: "south", north: "west", south: "west" };

const roomShapes = rooms.map(({ id, design: d, state, href, name }) => {
  const tw = d.w * 0.5;
  const th = Math.min(d.h * 0.28, 26);
  const tx = d.x + (d.w - tw) / 2;
  const ty = d.y + (d.h - th) / 2 + 4;
  // Big teaching rooms and labs draw at most 8 chairs — the seat count is
  // in the label; the drawing only says "this is a room you sit in".
  const drawn = Math.min(d.capacity, 8);
  const top = Math.ceil(drawn / 2);
  const bottom = Math.floor(drawn / 2);
  // Small rooms (Chifley's are ~40 units wide) get proportionally smaller chairs.
  const r = Math.max(2, Math.min(4, tw / (top + 1) / 2.4));
  const chairs = [
    ...Array.from({ length: top }, (_, i) => ({ cx: tx + (tw * (i + 1)) / (top + 1), cy: ty - r - 3 })),
    ...Array.from({ length: bottom }, (_, i) => ({ cx: tx + (tw * (i + 1)) / (bottom + 1), cy: ty + th + r + 3 })),
  ];
  return {
    id,
    href,
    state,
    label: d.label,
    aria: `${name}: ${stateWords[state]}, ${d.capacity} seats. Book this room.`,
    rect: { x: d.x, y: d.y, w: d.w, h: d.h },
    table: { x: tx, y: ty, w: tw, h: th },
    chairs,
    r,
    // Too small for furniture and two labels: just the room number, centred.
    compact: d.h < 45 || d.w < 45,
    door: wallSegment(d, d.door, 0.4, 0.6),
    screen: d.screen ? wallSegment(d, opposite[d.door], 0.3, 0.7) : null,
    whiteboard: d.whiteboard ? wallSegment(d, side[d.door], 0.25, 0.75) : null,
    labelPos: { x: d.x + d.w / 2, y: d.y + 14 },
    seatsPos: { x: d.x + d.w / 2, y: d.y + d.h - 5 },
    seats: `${d.capacity} seats`,
  };
});

const summary = rooms.map((r) => `${r.design.label} ${stateWords[r.state]}`).join(", ");
---

<svg
  class="plan"
  viewBox={`0 0 ${W} ${H}`}
  role="group"
  aria-label={`Floor plan of ${library.name}, ${library.level}. ${summary}.`}
>
  <defs>
    <pattern id={hatchId} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="6" class="hatch-line"></line>
    </pattern>
  </defs>

  <g aria-hidden="true">
    <path d={library.outline} class="plan-floor"></path>
    {features.map((f) => (
      <g class={`feature feature-${f.kind}`}>
        {f.outlined && <rect x={f.x} y={f.y} width={f.w} height={f.h} class="feature-outline"></rect>}
        {f.lines.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2}></line>)}
        {f.blocks.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} class="feature-block"></rect>)}
        {f.label && (
          <text x={f.labelPos.x} y={f.labelPos.y} text-anchor={f.labelPos.anchor}>
            {f.label}
          </text>
        )}
      </g>
    ))}
    <path d={library.outline} class="plan-wall"></path>
  </g>

  {roomShapes.map((r) => (
    <a href={r.href} aria-label={r.aria} class={`plan-room state-${r.state}`}>
      <rect
        x={r.rect.x}
        y={r.rect.y}
        width={r.rect.w}
        height={r.rect.h}
        class="room-shape"
        style={r.state === "booked" ? `fill: url(#${hatchId})` : undefined}
      ></rect>
      <g aria-hidden="true">
        <line x1={r.door.x1} y1={r.door.y1} x2={r.door.x2} y2={r.door.y2} class="door-gap"></line>
        {r.screen && <line x1={r.screen.x1} y1={r.screen.y1} x2={r.screen.x2} y2={r.screen.y2} class="screen"></line>}
        {r.whiteboard && (
          <line
            x1={r.whiteboard.x1}
            y1={r.whiteboard.y1}
            x2={r.whiteboard.x2}
            y2={r.whiteboard.y2}
            class="whiteboard"
          ></line>
        )}
        {!r.compact && <rect x={r.table.x} y={r.table.y} width={r.table.w} height={r.table.h} rx="3" class="table"></rect>}
        {!r.compact && r.chairs.map((c) => <circle cx={c.cx} cy={c.cy} r={r.r} class="chair"></circle>)}
        <text
          x={r.labelPos.x}
          y={r.compact ? r.rect.y + r.rect.h / 2 + 5 : r.labelPos.y}
          text-anchor="middle"
          class="room-label"
        >
          {r.label}
        </text>
        {!r.compact && <text x={r.seatsPos.x} y={r.seatsPos.y} text-anchor="middle" class="room-seats">{r.seats}</text>}
      </g>
    </a>
  ))}
</svg>
