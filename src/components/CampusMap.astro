---
import { type Library, googleMapsLink } from "../lib/layout";

interface Props {
  libraries: { library: Library; roomCount: number; inUse: number }[];
}

const { libraries } = Astro.props;

// Google Maps, centred between the libraries at a zoom that shows both —
// Google labels the buildings itself, so the map is the real campus rather
// than a drawing of it. The keyless embed can't carry more than one pin, so
// each library's exact pin is a link beside the map, next to its live
// status from this board.
const lats = libraries.map((l) => l.library.coords.lat);
const lngs = libraries.map((l) => l.library.coords.lng);
const centre = {
  lat: (Math.min(...lats) + Math.max(...lats)) / 2,
  lng: (Math.min(...lngs) + Math.max(...lngs)) / 2,
};
const embed = `https://maps.google.com/maps?ll=${centre.lat},${centre.lng}&z=17&t=m&output=embed`;
---

<div class="campus">
  <iframe
    class="campus-map"
    src={embed}
    title="Google Map of the ANU Acton campus around Hancock and Chifley libraries"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
  <ul class="campus-list">
    {libraries.map(({ library: l, roomCount, inUse }) => (
      <li class={inUse > 0 ? "in-use" : undefined}>
        <strong>{l.name}</strong>
        <span class="campus-building">{l.building}</span>
        <span class="campus-status">
          {roomCount} bookable room{roomCount === 1 ? "" : "s"}
          {inUse > 0 && <span class="campus-now"> · {inUse} in use now</span>}
        </span>
        <span class="campus-links">
          <a href={`#lib-${l.id}`}>Floor plan</a>
          <a href={googleMapsLink(l.coords)} rel="noopener" target="_blank">Open in Google Maps</a>
        </span>
      </li>
    ))}
  </ul>
</div>
