---
import { addMinutesToTime, canberraParts, canberraWallTimeToEpochMs, nextReloadTargetEpochMs, shiftDate } from "../lib/clock";
import { GRACE_MINUTES, expireNoShows, listBookingsForDate, listRooms } from "../lib/db";
import { LIBRARIES, type RoomState, describeRoom, designFor } from "../lib/layout";
import CampusMap from "../components/CampusMap.astro";
import FloorPlan from "../components/FloorPlan.astro";
import Timetable from "../components/Timetable.astro";
import "../styles.css";

// All times on this board are Canberra wall-clock text (see src/lib/schema.ts)
// — "now" has to be read the same way, regardless of what timezone the
// machine running the server happens to be in.
const { date: today, time: nowTime } = canberraParts(new Date());
const requestedDate = Astro.url.searchParams.get("date");
const date = requestedDate && /^\d{4}-\d{2}-\d{2}$/.test(requestedDate) ? requestedDate : today;
const isToday = date === today;
const error = Astro.url.searchParams.get("error");

const errorMessages: Record<string, string> = {
  conflict: "That room is already booked for part of this time — pick another slot.",
  date: "That's not a date the board understands — pick one from the calendar.",
  invalid: "The end time has to be after the start time.",
  name: "Enter your name so the room knows who's got it.",
  room: "Pick a room.",
};

// Sweeps today's no-shows (see db.ts's expireNoShows) before anything below
// reads the list, so a booking past its check-in deadline is simply gone —
// there's no separate "expired" state for the rest of this page to render.
// Only ever run for today: a past date's history is never retroactively
// erased, the same scoping isNowWithin below already uses.
if (isToday) expireNoShows(date, nowTime);

const rooms = listRooms();
const bookingsForDate = listBookingsForDate(date);
// Whether "now" falls inside a booking is decided here, in plain TS, and
// carried on the data — the Astro compiler reads a bare `<` inside a JSX-like
// expression as the start of a tag, so that comparison can't live inline in
// the template below.
const isNowWithin = (start: string, end: string) => isToday && start <= nowTime && nowTime < end;
const roomsWithBookings = rooms.map((room) => ({
  room,
  bookings: bookingsForDate
    .filter((b) => b.roomId === room.id)
    .map((b) => {
      const active = isNowWithin(b.startTime, b.endTime);
      const checkedIn = b.checkedInAt !== null;
      // Only an active, un-checked-in booking is on the clock — this is the
      // wall-clock time expireNoShows will reclaim it at on some future
      // render, shown so the room's actual occupant has a reason to hit
      // "Check in" before then.
      const noShowDeadline = active && !checkedIn ? addMinutesToTime(b.startTime, GRACE_MINUTES) : null;
      return { ...b, active, checkedIn, noShowDeadline };
    }),
}));

// The physical view: rooms grouped under the library they sit in, each with
// a state for its floor-plan shape. "booked" means there's still a booking
// ahead of it on this date (on today, one that hasn't ended yet) — drawn as
// ink hatching, so gold stays the one colour for "in use right now".
const preselectRoom = Number(Astro.url.searchParams.get("room"));
// A timetable slot link carries its hour; only well-formed times prefill.
const timeParam = (name: string) => {
  const v = Astro.url.searchParams.get(name) ?? "";
  return /^([01]\d|2[0-3]):[0-5]\d$/.test(v) ? v : undefined;
};
const prefillStart = timeParam("start");
const prefillEnd = timeParam("end");
// Two views of the same day, kept in the URL so every link and reload lands
// on the same one: the floor plans (default) or the timetable.
const view = Astro.url.searchParams.get("view") === "timetable" ? "timetable" : "plans";
const viewHref = (v: string) => `/?${new URLSearchParams({ date, ...(v === "timetable" ? { view: v } : {}) })}`;
const stateOf = (bookings: (typeof roomsWithBookings)[number]["bookings"]): RoomState =>
  bookings.some((b) => b.active)
    ? "now"
    : bookings.some((b) => !isToday || b.endTime > nowTime)
      ? "booked"
      : "free";
const libraries = LIBRARIES.map((library) => {
  const libRooms = roomsWithBookings.flatMap((entry) => {
    const design = designFor(entry.room.name);
    return design && design.library === library.id ? [{ ...entry, design, state: stateOf(entry.bookings) }] : [];
  });
  return {
    library,
    rooms: libRooms,
    plan: libRooms.map(({ room, design, state }) => ({
      id: room.id,
      name: room.name,
      design,
      state,
      href: `/?${new URLSearchParams({ date, room: String(room.id) })}#book`,
    })),
    inUse: libRooms.filter((r) => r.state === "now").length,
  };
}).filter((l) => l.rooms.length > 0);

// Passed to the client script below so a tab left open across a booking's
// start/end minute — or across midnight, with no bookings left to wait for
// today — reloads itself right then, instead of only when some other tab's
// booking happens to trigger the SSE reload. A tab parked on *tomorrow*'s
// view gets the same treatment for the one boundary that matters to it: the
// moment real midnight arrives, this date stops being tomorrow and becomes
// today, so its "(today)" label and live highlighting need to switch on —
// any date further out has no near-term boundary worth waiting for.
//
// This is the real UTC instant of that boundary, not a minute count: a
// minute count handed to the client's own setTimeout would assume a
// wall-clock minute is always a real minute, which is false on the two
// nights a year Canberra's clocks shift for daylight saving (see
// canberraWallTimeToEpochMs in src/lib/clock.ts) — the client instead
// computes its own delay as target-minus-now at load time.
const noShowDeadlines = roomsWithBookings.flatMap(({ bookings }) =>
  bookings.flatMap((b) => (b.noShowDeadline ? [b.noShowDeadline] : [])),
);
const nextBoundaryTarget = isToday
  ? nextReloadTargetEpochMs(date, nowTime, [
      ...bookingsForDate.flatMap((b) => [b.startTime, b.endTime]),
      ...noShowDeadlines,
    ])
  : date === shiftDate(today, 1)
    ? canberraWallTimeToEpochMs(date, "00:00")
    : null;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A live board for ANU Library group study rooms — book a slot, see who's got a room right now, cancel one you don't need."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Room board</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Room board</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Room board</h1>
      <p>
        A shared, live view of ANU group study rooms, teaching rooms and computer labs across Hancock, Chifley, Marie
        Reay, Hanna Neumann and Skaidrite Darius: who's booked what, and what's free — see the
        <a href="/readme/">README</a> for what this prototype is standing in for.
      </p>

      <nav aria-label="date">
        <a href={`/?date=${shiftDate(date, -1)}${view === "timetable" ? "&view=timetable" : ""}`}>&larr; {shiftDate(date, -1)}</a>
        <strong>{date}{isToday ? " (today)" : ""}</strong>
        <a href={`/?date=${shiftDate(date, 1)}${view === "timetable" ? "&view=timetable" : ""}`}>{shiftDate(date, 1)} &rarr;</a>
      </nav>

      {error && (
        <p class="error" role="alert">
          {errorMessages[error] ?? "Something went wrong — try again."}
        </p>
      )}

      <section class="campus-section" aria-labelledby="campus-heading">
        <h2 id="campus-heading">Where the rooms are</h2>
        <CampusMap libraries={libraries.map((l) => ({ library: l.library, roomCount: l.rooms.length, inUse: l.inUse }))} />
      </section>

      <ul class="legend" aria-label="Floor plan key">
        <li><span class="swatch swatch-free"></span>Available (blue outline)</li>
        <li><span class="swatch swatch-booked"></span>Booked later</li>
        <li><span class="swatch swatch-now"></span>In use now</li>
      </ul>

      <nav class="view-toggle" aria-label="view">
        <a href={viewHref("plans")} aria-current={view === "plans" ? "page" : undefined}>Floor plans</a>
        <a href={viewHref("timetable")} aria-current={view === "timetable" ? "page" : undefined}>Timetable</a>
      </nav>

      {view === "timetable" && (
      <section class="timetable-section" aria-labelledby="timetable-heading">
        <h2 id="timetable-heading">Timetable for {date}{isToday ? " (today)" : ""}</h2>
        <Timetable
          date={date}
          isToday={isToday}
          nowTime={nowTime}
          rooms={libraries.flatMap(({ library, rooms: libRooms }) =>
            libRooms.map(({ room, design, bookings }) => ({
              id: room.id,
              label: design.label,
              library: library.name,
              bookings,
            })),
          )}
        />
      </section>
      )}

      {view === "plans" && (
      <section class="layouts" aria-labelledby="layouts-heading">
        <div class="layouts-head">
          <h2 id="layouts-heading">Floor layouts</h2>
          <span class="layouts-actions">
            <button type="button" data-details="open">Open all</button>
            <button type="button" data-details="close">Close all</button>
          </span>
        </div>
      {libraries.map(({ library, rooms: libRooms, plan, inUse }) => (
        <details class="building" id={`lib-${library.id}`} open={libRooms.some((r) => r.bookings.length > 0)}>
          <summary>
            <span class="building-title">
              <h3 id={`lib-${library.id}-heading`}>{library.name}</h3>
              <span class="level">{library.level}</span>
            </span>
            <span class="building-status">
              <span class="chip chip-free">{libRooms.length - inUse} available</span>
              {inUse > 0 && <span class="chip chip-now">{inUse} in use</span>}
            </span>
          </summary>
          <div class="library-body">
          <figure class="plan-figure">
            <FloorPlan library={library} rooms={plan} />
            <figcaption class="plan-caption">
              <span>{library.level}, from {library.source}.</span>
              <button type="button" class="plan-toggle" aria-expanded="false">Enlarge plan</button>
            </figcaption>
          </figure>
          <div class="rooms">
        {libRooms.map(({ room, bookings, design, state }) => (
          <section class={state === "now" ? "room" : "room available"} aria-labelledby={`room-${room.id}`}>
            <h4 id={`room-${room.id}`}>{room.name}</h4>
            <p class="room-meta">{describeRoom(design)}</p>
            <ul>
              {bookings.length === 0 && <li class="empty">Free all day</li>}
              {bookings.map((booking) => (
                <li class={booking.active ? "active" : undefined}>
                  <span class="time">
                    {booking.startTime}–{booking.endTime}
                  </span>
                  <span class="who">{booking.bookedBy}</span>
                  {booking.noShowDeadline && (
                    <span class="no-show-note">auto-releases at {booking.noShowDeadline} unless checked in</span>
                  )}
                  {booking.active && !booking.checkedIn && (
                    <form method="post" action={`/api/bookings/${booking.id}/checkin`}>
                      <input type="hidden" name="date" value={date} />
                      <button type="submit">Check in</button>
                    </form>
                  )}
                  <form method="post" action={`/api/bookings/${booking.id}/cancel`}>
                    <input type="hidden" name="date" value={date} />
                    <button type="submit">Cancel</button>
                  </form>
                </li>
              ))}
            </ul>
          </section>
        ))}
          </div>
          </div>
        </details>
      ))}
      </section>
      )}

      <form method="post" action="/api/bookings" class="book-form" id="book">
        <h2>Book a room</h2>
        <input type="hidden" name="date" value={date} />
        <div>
          <label for="roomId">Room</label>
          <select id="roomId" name="roomId" required>
            {rooms.map((room) => (
              <option value={room.id} selected={room.id === preselectRoom}>{room.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="bookedBy">Your name</label>
          <input id="bookedBy" name="bookedBy" required maxlength="80" />
        </div>
        <div>
          <label for="startTime">From</label>
          <input id="startTime" name="startTime" type="time" required value={prefillStart} />
        </div>
        <div>
          <label for="endTime">To</label>
          <input id="endTime" name="endTime" type="time" required value={prefillEnd} />
        </div>
        <button>Book {date}</button>
      </form>
    </main>
    <script is:inline define:vars={{ date, nextBoundaryTarget }}>
      // The board's live half: any tab looking at this same date reloads the
      // moment a booking is made or cancelled anywhere, so two people looking
      // at the same day never work from stale information. The form itself
      // needs none of this — its own POST + redirect already re-renders from
      // SQLite.
      const source = new EventSource("/api/events");
      source.addEventListener("booking", (event) => {
        const payload = JSON.parse(event.data);
        if (payload.date === date) location.reload();
      });

      // The SSE stream carries no state of its own, just a "something
      // changed" signal — so a connection that drops (a network blip, a
      // server restart on deploy) and reconnects has no way to know what it
      // missed while it was down. "open" fires on every reconnect as well as
      // the first connect; reload on every one after the first, since by
      // then the only safe assumption is that something might have changed.
      let hasOpenedBefore = false;
      source.addEventListener("open", () => {
        if (hasOpenedBefore) location.reload();
        hasOpenedBefore = true;
      });

      // The other half of "live": the "happening now" highlight and the
      // date-nav's "(today)" label are both computed once, at render time.
      // With no other tab ever booking or cancelling anything today, this
      // tab would otherwise keep showing that render's answer forever —
      // past the end of a highlighted slot, past midnight into a day this
      // render was never "today" for, or (on a tab left parked on tomorrow's
      // view) past midnight into the moment that date becomes today and
      // ought to switch its label and highlighting on. `nextBoundaryTarget`
      // (the real UTC instant of the next booking start/end today, of
      // midnight if nothing's left to wait for today, or of midnight if
      // this view is tomorrow's date) is computed server-side, correctly
      // across a Canberra daylight-saving transition — see
      // canberraWallTimeToEpochMs in src/lib/clock.ts. The client just
      // takes the delay from its own clock at load time, rather than
      // trusting a minute count computed at render time to still equal the
      // same number of real milliseconds by the time it fires.
      // Floor plans are drawn at the real building's proportions, which is
      // tall and thin at card size — clicking one (anywhere but a room,
      // which stays a link to book it) opens it full-screen; Esc, the
      // button, or another click puts it back.
      const setExpanded = (figure, on) => {
        figure.classList.toggle("expanded", on);
        document.body.classList.toggle("plan-open", on);
        const button = figure.querySelector(".plan-toggle");
        button.setAttribute("aria-expanded", String(on));
        button.textContent = on ? "Close plan ✕" : "Enlarge plan";
        if (on) button.focus();
      };
      for (const figure of document.querySelectorAll(".plan-figure")) {
        figure.addEventListener("click", (event) => {
          if (event.target.closest("a")) return;
          setExpanded(figure, !figure.classList.contains("expanded"));
        });
      }
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        for (const figure of document.querySelectorAll(".plan-figure.expanded")) setExpanded(figure, false);
      });

      // Floor layouts are collapsible: "Open all"/"Close all", and a campus
      // map link to #lib-<id> opens that building's panel before jumping.
      for (const button of document.querySelectorAll("[data-details]")) {
        button.addEventListener("click", () => {
          const open = button.dataset.details === "open";
          for (const d of document.querySelectorAll("details.building")) d.open = open;
        });
      }
      const openFromHash = () => {
        const target = location.hash && document.querySelector(location.hash);
        if (target instanceof HTMLDetailsElement) target.open = true;
      };
      addEventListener("hashchange", openFromHash);
      openFromHash();

      if (nextBoundaryTarget !== null) {
        setTimeout(() => location.reload(), Math.max(0, nextBoundaryTarget - Date.now()) + 5_000);
      }
    </script>
  </body>
</html>
